    Variety "1" --> "*" VarietyFactor : variety_id
    AgronomicReferenceSet "0..1" --> "*" StageFactor : reference_set_id
    PhenologicalStageTemplate "1" --> "*" StageFactor : stage_id
    AgronomicReferenceSet "0..1" --> "*" EfficiencyFactor : reference_set_id
    SoilType "1" --> "*" EfficiencyFactor : soil_type_id
    Parcel "1" --> "*" FertilizationPlan : parcel_id
    Reading "0..1" --> "*" FertilizationPlan : reading_id
