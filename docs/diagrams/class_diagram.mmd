classDiagram
    %% Persisted SQLAlchemy models; reviewed 2026-09-05.
    %% Nullable fields use the optional marker; relationships follow foreign keys.
    class AgronomicReferenceSet {
        uuid id PK
        str key
        str version
        str source
        str description optional
        bool is_active
        datetime created_at
    }
    class SoilReferenceRange {
        uuid id PK
        uuid reference_set_id FK
        uuid crop_id FK
        str parameter
        str label_es
        str unit
        str method
        str confidence
        float deficient_below optional
        float optimal_min optional
        float optimal_max optional
        float critical_above optional
        bool high_is_generally_favorable
        str notes
    }
    class FertilizerProduct {
        uuid id PK
        uuid reference_set_id FK
        str key
        str name
        bool is_low_chloride
        bool is_active
    }
    class FertilizerProductNutrient {
        uuid id PK
        uuid product_id FK
        str nutrient
        float fraction
    }
    class ApplicationScheduleRule {
        uuid id PK
        uuid reference_set_id FK
        uuid crop_id FK
        str life_stage
        int sequence
        str moment
        int month_after_planting optional
        float fraction
    }
    class AgronomicParameter {
        uuid id PK
        uuid reference_set_id FK
        uuid crop_id FK
        str key
        float value
        str unit optional
        str notes optional
    }
    class Alert {
        uuid id PK
        uuid farm_id FK
        uuid parcel_id FK optional
        str type
        str title
        str message
        str severity
        date event_date optional
        float risk_score optional
        bool is_active
        datetime created_at
    }
    class Crop {
        uuid id PK
        datetime created_at
        datetime updated_at
        str name
    }
    class Variety {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid crop_id FK
        str name
    }
    class Farm {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        str name
        float area_hectares
        float latitude
        float longitude
    }
    class Parcel {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid farm_id FK
        uuid crop_id FK
        uuid variety_id FK optional
        str name
        float area_hectares
        int plants_per_hectare optional
        Date planting_date
    }
    class OptimalRequirement {
        uuid id PK
        uuid reference_set_id FK optional
        uuid crop_id FK
        uuid stage_id FK
        str nutrient
        float min_value
        float max_value
    }
    class ExtractionIndex {
        uuid id PK
        uuid reference_set_id FK optional
        uuid crop_id FK
        str nutrient
        float ie_value
    }
    class VarietyFactor {
        uuid id PK
        uuid reference_set_id FK optional
        uuid variety_id FK
        str nutrient
        float fv_factor
    }
    class StageFactor {
        uuid id PK
        uuid reference_set_id FK optional
        uuid stage_id FK
        str nutrient
        float fe_factor
    }
    class SoilType {
        uuid id PK
        str name
        str description optional
    }
    class EfficiencyFactor {
        uuid id PK
        uuid reference_set_id FK optional
        uuid soil_type_id FK
        str nutrient
        float ef_min
        float ef_max
    }
    class FertilizationPlan {
        uuid id PK
        uuid parcel_id FK
        uuid reading_id FK optional
        uuid lab_analysis_id FK optional
        uuid reference_set_id FK
        str method
        str input_fingerprint optional
        JSON recommendation_snapshot optional
        float target_green_kg_ha
        int plant_age_months
        str life_stage
        str fruit_stage
        str engine_version
        str recommendation_status
        JSON nutrient_requirements
        JSON limiting_nutrients
        JSON warnings
        JSON assumptions
        datetime generated_at
    }
    class FertilizationPlanItem {
        uuid id PK
        uuid plan_id FK
        uuid fertilizer_product_id FK
        str scenario_name
        str selection_method
        bool scenario_is_valid
        int application_number
        str moment
        float fraction
        float kg_ha
        float kg_manzana
        float g_plant
        JSON guaranteed_analysis_pct
        JSON nutrient_contributions_kg_ha
    }
    class Expense {
        uuid id PK
        uuid farm_id FK
        str category
        float amount
        date expense_date
    }
    class Income {
        uuid id PK
        uuid farm_id FK
        float amount
        date income_date
    }
    class Production {
        uuid id PK
        uuid farm_id FK
        uuid income_id FK optional
        float quantity
        str unit
        date harvest_date
    }
    class PhenologicalStageTemplate {
        uuid id PK
        uuid crop_id FK
        str name
        int stage_order
        int duration_days optional
    }
    class ParcelPhenologicalStage {
        uuid id PK
        uuid parcel_id FK
        uuid template_id FK
        date estimated_date optional
        date actual_date optional
        datetime selected_at
    }
    class Reading {
        uuid id PK
        uuid parcel_id FK
        float nitrogen
        float phosphorus
        float potassium
        float ec
        float ph
        float temperature
        float humidity
        datetime recorded_at
    }
    class LabAnalysis {
        uuid id PK
        uuid parcel_id FK
        str sample_code optional
        datetime sampled_at optional
        float depth_start_cm optional
        float depth_end_cm optional
        float ph
        str ph_method optional
        float ec optional
        str ec_method optional
        float organic_matter_pct
        float cic
        float clay_pct
        float silt_pct
        float sand_pct
        float nitrogen
        float phosphorus
        str phosphorus_method optional
        float potassium
        str potassium_method optional
        float calcium
        float magnesium
        float sulfur
        str lab
        datetime recorded_at
    }
    class User {
        uuid id PK
        string name
        string email
        string role
        date birth_date
        string gender
        string phone
        string country
        string department
        string address
        datetime created_at
        datetime updated_at
    }
