---
config:
  layout: elk
---
erDiagram
  direction TB

  %% Core farm structure
  USER ||--o{ FARM : owns
  FARM ||--o{ PARCEL : contains
  CROP ||--o{ PARCEL : grows_in
  CROP ||--o{ VARIETY : has
  VARIETY o|--o{ PARCEL : specifies

  USER {
    uuid id PK
    string name
    string email
    string role
    date birth_date
    string gender
    string phone
    string country
    string department
    string address
    datetime created_at
    datetime updated_at
  }

  FARM {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid user_id FK
    string name
    float area_hectares
    float latitude
    float longitude
  }

  PARCEL {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid farm_id FK
    uuid crop_id FK
    uuid variety_id FK
    string name
    float area_hectares
    int plants_per_hectare
    Date planting_date
  }

  CROP {
    uuid id PK
    datetime created_at
    datetime updated_at
    string name
  }

  VARIETY {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid crop_id FK
    string name
  }

  %% Monitoring and analysis
  PARCEL ||--o{ READING : records
  PARCEL ||--o{ LAB_ANALYSIS : records

  READING {
    uuid id PK
    uuid parcel_id FK
    float nitrogen
    float phosphorus
    float potassium
    float ec
    float ph
    float temperature
    float humidity
    datetime recorded_at
  }

  LAB_ANALYSIS {
    uuid id PK
    uuid parcel_id FK
    string sample_code
    datetime sampled_at
    float depth_start_cm
    float depth_end_cm
    float ph
    string ph_method
    float ec
    string ec_method
    float organic_matter_pct
    float cic
    float clay_pct
    float silt_pct
    float sand_pct
    float nitrogen
    float phosphorus
    string phosphorus_method
    float potassium
    string potassium_method
    float calcium
    float magnesium
    float sulfur
    string lab
    datetime recorded_at
  }
  %% Crop stages and requirements
  CROP ||--o{ PHENOLOGICAL_STAGE_TEMPLATE : defines
  PHENOLOGICAL_STAGE_TEMPLATE ||--o{ PARCEL_PHENOLOGICAL_STAGE : instantiates
  PARCEL ||--o{ PARCEL_PHENOLOGICAL_STAGE : schedules

  CROP ||--o{ OPTIMAL_REQUIREMENT : sets
  PHENOLOGICAL_STAGE_TEMPLATE ||--o{ OPTIMAL_REQUIREMENT : applies_at
  CROP ||--o{ EXTRACTION_INDEX : defines
  VARIETY ||--o{ VARIETY_FACTOR : adjusts
  PHENOLOGICAL_STAGE_TEMPLATE ||--o{ STAGE_FACTOR : adjusts

  PHENOLOGICAL_STAGE_TEMPLATE {
    uuid id PK
    uuid crop_id FK
    string name
    int stage_order
    int duration_days
  }
  PARCEL_PHENOLOGICAL_STAGE {
    uuid id PK
    uuid parcel_id FK
    uuid template_id FK
    date estimated_date
    date actual_date
    datetime selected_at
  }

  OPTIMAL_REQUIREMENT {
    uuid id PK
    uuid reference_set_id FK
    uuid crop_id FK
    uuid stage_id FK
    string nutrient
    float min_value
    float max_value
  }

  EXTRACTION_INDEX {
    uuid id PK
    uuid reference_set_id FK
    uuid crop_id FK
    string nutrient
    float ie_value
  }

  VARIETY_FACTOR {
    uuid id PK
    uuid reference_set_id FK
    uuid variety_id FK
    string nutrient
    float fv_factor
  }

  STAGE_FACTOR {
    uuid id PK
    uuid reference_set_id FK
    uuid stage_id FK
    string nutrient
    float fe_factor
  }

  %% Agronomic reference data
  AGRONOMIC_REFERENCE_SET ||--o{ SOIL_REFERENCE_RANGE : versions
  AGRONOMIC_REFERENCE_SET ||--o{ FERTILIZER_PRODUCT : versions
  AGRONOMIC_REFERENCE_SET ||--o{ APPLICATION_SCHEDULE_RULE : versions
  AGRONOMIC_REFERENCE_SET ||--o{ AGRONOMIC_PARAMETER : versions
  AGRONOMIC_REFERENCE_SET o|--o{ OPTIMAL_REQUIREMENT : versions
  AGRONOMIC_REFERENCE_SET o|--o{ EXTRACTION_INDEX : versions
  AGRONOMIC_REFERENCE_SET o|--o{ VARIETY_FACTOR : versions
  AGRONOMIC_REFERENCE_SET o|--o{ STAGE_FACTOR : versions
  AGRONOMIC_REFERENCE_SET o|--o{ EFFICIENCY_FACTOR : versions

  SOIL_TYPE ||--o{ EFFICIENCY_FACTOR : defines
  CROP ||--o{ SOIL_REFERENCE_RANGE : defines
  CROP ||--o{ APPLICATION_SCHEDULE_RULE : schedules
  CROP ||--o{ AGRONOMIC_PARAMETER : configures

  AGRONOMIC_REFERENCE_SET {
    uuid id PK
    string key
    string version
    string source
    string description
    boolean is_active
    datetime created_at
  }

  SOIL_TYPE {
    uuid id PK
    string name
    string description
  }

  SOIL_REFERENCE_RANGE {
    uuid id PK
    uuid reference_set_id FK
    uuid crop_id FK
    string parameter
    string label_es
    string unit
    string method
    string confidence
    float deficient_below
    float optimal_min
    float optimal_max
    float critical_above
    boolean high_is_generally_favorable
    string notes
  }

  EFFICIENCY_FACTOR {
    uuid id PK
    uuid reference_set_id FK
    uuid soil_type_id FK
    string nutrient
    float ef_min
    float ef_max
  }

  AGRONOMIC_PARAMETER {
    uuid id PK
    uuid reference_set_id FK
    uuid crop_id FK
    string key
    float value
    string unit
    string notes
  }

  %% Fertilization
  FERTILIZER_PRODUCT ||--o{ FERTILIZER_PRODUCT_NUTRIENT : contains
  PARCEL ||--o{ FERTILIZATION_PLAN : generates
  READING o|--o{ FERTILIZATION_PLAN : originates
  LAB_ANALYSIS o|--o{ FERTILIZATION_PLAN : originates
  AGRONOMIC_REFERENCE_SET ||--o{ FERTILIZATION_PLAN : reproduces
  FERTILIZATION_PLAN ||--o{ FERTILIZATION_PLAN_ITEM : contains
  FERTILIZER_PRODUCT ||--o{ FERTILIZATION_PLAN_ITEM : recommends

  FERTILIZER_PRODUCT {
    uuid id PK
    uuid reference_set_id FK
    string key
    string name
    boolean is_low_chloride
    boolean is_active
  }

  FERTILIZER_PRODUCT_NUTRIENT {
    uuid id PK
    uuid product_id FK
    string nutrient
    float fraction
  }

  APPLICATION_SCHEDULE_RULE {
    uuid id PK
    uuid reference_set_id FK
    uuid crop_id FK
    string life_stage
    int sequence
    string moment
    int month_after_planting
    float fraction
  }

  FERTILIZATION_PLAN {
    uuid id PK
    uuid parcel_id FK
    uuid reading_id FK
    uuid lab_analysis_id FK
    uuid reference_set_id FK
    string method
    string input_fingerprint
    json recommendation_snapshot
    float target_green_kg_ha
    int plant_age_months
    string life_stage
    string fruit_stage
    string engine_version
    string recommendation_status
    json nutrient_requirements
    json limiting_nutrients
    json warnings
    json assumptions
    datetime generated_at
  }
  FERTILIZATION_PLAN_ITEM {
    uuid id PK
    uuid plan_id FK
    uuid fertilizer_product_id FK
    string scenario_name
    string selection_method
    boolean scenario_is_valid
    int application_number
    string moment
    float fraction
    float kg_ha
    float kg_manzana
    float g_plant
    json guaranteed_analysis_pct
    json nutrient_contributions_kg_ha
  }
  %% Farm events and finances
  FARM ||--o{ ALERT : triggers
  PARCEL o|--o{ ALERT : scopes
  FARM ||--o{ EXPENSE : incurs
  FARM ||--o{ INCOME : receives
  FARM ||--o{ PRODUCTION : yields
  INCOME o|--o{ PRODUCTION : aggregates

  ALERT {
    uuid id PK
    uuid farm_id FK
    uuid parcel_id FK
    string type
    string title
    string message
    string severity
    date event_date
    float risk_score
    boolean is_active
    datetime created_at
  }

  EXPENSE {
    uuid id PK
    uuid farm_id FK
    string category
    float amount
    date expense_date
  }

  INCOME {
    uuid id PK
    uuid farm_id FK
    float amount
    date income_date
  }

  PRODUCTION {
    uuid id PK
    uuid farm_id FK
    uuid income_id FK
    float quantity
    string unit
    date harvest_date
  }
