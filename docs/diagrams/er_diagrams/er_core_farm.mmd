erDiagram
  USER ||--o{ FARM : owns
  FARM ||--o{ PARCEL : contains
  CROP ||--o{ PARCEL : grows
  CROP ||--o{ VARIETY : has
  VARIETY o|--o{ PARCEL : specifies

  USER {
    uuid id PK
    string name
    string email
    string role
    date birth_date
    string gender
    string phone
    string country
    string department
    string address
    datetime created_at
    datetime updated_at
  }
  FARM {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid user_id FK
    string name
    float area_hectares
    float latitude
    float longitude
  }
  PARCEL {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid farm_id FK
    uuid crop_id FK
    uuid variety_id FK
    string name
    float area_hectares
    int plants_per_hectare
    Date planting_date
  }
  CROP {
    uuid id PK
    datetime created_at
    datetime updated_at
    string name
  }
  VARIETY {
    uuid id PK
    datetime created_at
    datetime updated_at
    uuid crop_id FK
    string name
  }
